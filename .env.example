# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 排除，绝不提交）
# 用法：cd 项目根目录 && source .env
# 真实 key 泄露的唯一常见原因：误提交进 git。每次提交前 git status 确认没有 .env。

export DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
export ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== embedding 备胎（可选；zhixing.llm.embedding.fallback 配为 siliconflow/BAAI/bge-m3 时启用） =====
# export SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 数据库连接（可选；本地开发默认 127.0.0.1:5432，Compose 内自动指向 db 容器） =====
# export PG_URL=jdbc:postgresql://127.0.0.1:5432/zhixing
# export PG_USER=postgres
# export PG_PASSWORD=postgres
