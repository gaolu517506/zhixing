<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhixing</groupId>
        <artifactId>zhixing</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>zhixing-bootstrap</artifactId>
    <name>zhixing-bootstrap</name>
    <description>启动与战争面：Application、controller、application.yaml、prompts、db 脚本</description>

    <dependencies>
        <dependency>
            <groupId>com.zhixing</groupId>
            <artifactId>zhixing-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 根 pom pluginManagement 默认 skip=true（防裸命令在库模块上跑 run goal），
                         唯一可执行模块必须显式打开；repackage 同受此参数控制，须为 false -->
                    <skip>false</skip>
                    <!-- 工作目录钉在项目根：相对路径资源（mcp-server-demo、data/files）与
                         单模块时代行为一致，-pl 单模块启动不漂移 -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
